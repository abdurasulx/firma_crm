# Django
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=False
ALLOWED_HOSTS=stockfirm.uz,www.stockfirm.uz,*.stockfirm.uz
CSRF_TRUSTED_ORIGINS=https://stockfirm.uz,https://www.stockfirm.uz,https://*.stockfirm.uz
BASE_DOMAIN=stockfirm.uz

# Click
CLICK_SERVICE_ID=replace-with-click-service-id
CLICK_MERCHANT_ID=replace-with-click-merchant-id
CLICK_SECRET_KEY=replace-with-click-secret-key

# Optional: comma-separated Click source IP allow-list.
# Leave empty until Click gives you the final production IPs.
CLICK_ALLOWED_IPS=

# Telegram bot
TELEGRAM_BOT_TOKEN=replace-with-bot-token

# Database (sqlite by default; set DB_ENGINE=mysql for MySQL)
DB_ENGINE=sqlite
