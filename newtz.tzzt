🧠 3. Routing logikasi (MUHIM)
Middleware yangilanishi:
class CompanyMiddleware:
    def __init__(self, get_response):
        self.get_response = get_response

    def __call__(self, request):
        host = request.get_host().split(':')[0]

        parts = host.split('.')

        # stockfirm.uz → landing
        if host == "stockfirm.uz" or host == "www.stockfirm.uz":
            request.company = None
            request.is_landing = True

        # admin.stockfirm.uz → super admin
        elif parts[0] == "admin":
            request.company = None
            request.is_admin_panel = True

        # firma subdomain
        else:
            subdomain = parts[0]
            try:
                company = Company.objects.get(subdomain=subdomain)
                request.company = company
                request.is_landing = False
            except Company.DoesNotExist:
                request.company = None

        return self.get_response(request)
