🔹 URL:
# urls.py
urlpatterns = [
    path('', landing_home),
    path('pricing/', pricing_view),
]
🔹 View logikasi:
def landing_home(request):
    if getattr(request, "is_landing", False):
        return render(request, "landing/index.html")
    
    return redirect("/")  # noto‘g‘ri kirish bo‘lsa
